   "scene": 1,
   "start": 0.0,
   "end": 3.514,
   "said": [
    "日本の鉄道のトップが、",
    "デパートに入り、",
    "二度と出てこなかった。"
   ],
   "edit": "hook",
   "photos": [
    {
     "image": "mitsu",
     "ai": false,
